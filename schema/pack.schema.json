{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.schema.json",
  "title": "Learn content pack (one chapter)",
  "type": "object",
  "required": ["schema", "pack", "book", "chapter"],
  "properties": {
    "schema": { "const": 1 },
    "pack": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "created": { "type": "string" }
      }
    },
    "book": {
      "type": "object",
      "required": ["id", "title", "license", "attribution"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "authors": { "type": "array", "items": { "type": "string" } },
        "publisher": { "type": "string" },
        "license": { "type": "string", "minLength": 1, "not": { "pattern": "\\bND\\b" } },
        "licenseUrl": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "attribution": { "type": "string", "minLength": 1 },
        "language": { "type": "string" }
      }
    },
    "chapter": {
      "type": "object",
      "required": ["id", "title", "sections"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "number": { "type": ["integer", "string"] },
        "title": { "type": "string", "minLength": 1 },
        "order": { "type": "number" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
      }
    },
    "media": {
      "type": "object",
      "propertyNames": { "pattern": "^media/[A-Za-z0-9._-]+$" },
      "additionalProperties": { "type": "string", "pattern": "^data:image/(webp|png|jpeg|gif|avif);base64,[A-Za-z0-9+/]+={0,2}$" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$" },
    "section": {
      "type": "object",
      "required": ["id", "title", "html"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "order": { "type": "number" },
        "html": { "type": "string" },
        "summary": { "type": "string" },
        "keyTerms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["term"],
            "properties": { "term": { "type": "string" }, "definition": { "type": "string" } }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "prompt": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "mcq" } } },
          "then": {
            "required": ["prompt", "options", "answer"],
            "properties": {
              "options": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "string", "minLength": 1 } },
              "answer": { "type": "integer", "minimum": 0 },
              "explanation": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "explain" } } },
          "then": {
            "required": ["prompt"],
            "properties": {
              "rubric": { "type": "array", "items": { "type": "string" } },
              "reference": { "type": "string" }
            }
          }
        }
      ]
    }
  }
}
